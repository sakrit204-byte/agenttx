# AgentTx guest kernel: DEBUG build.
#
# This is what you develop on.  Every WORKFLOW.md section 5 review item --
# "KASAN clean", "run lockdep", "does it leak over ten insmod/rmmod cycles" --
# is checked on this kernel and nowhere else.
#
# It is 2-4x slower than the perf build and uses noticeably more memory.
# That is the trade you want while writing the code and exactly the trade
# you must not make while measuring it.  See kernel-perf.config.

# --- KASAN.  Use-after-free in kernel code is silent until it is not. -----
# INLINE is ~2x faster than OUTLINE at the cost of a bigger image; on a
# 12-core host the build cost is not the bottleneck.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y
CONFIG_STACKTRACE=y

# --- lockdep.  P1's hashtable (P1-05) and P3's ring (P3-07) are both
#     touched from process and interrupt context; this is what tells you
#     which one you got wrong. ---------------------------------------------
CONFIG_PROVE_LOCKING=y
CONFIG_LOCKDEP=y
CONFIG_DEBUG_LOCK_ALLOC=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RWSEMS=y

# --- "can it sleep here?"  P3-10's sleepable hooks make this a live
#     question rather than a theoretical one. -----------------------------
CONFIG_DEBUG_ATOMIC_SLEEP=y

# --- Allocation and object lifetime. --------------------------------------
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y

# --- Undefined behaviour and stack overruns. ------------------------------
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- Panic behaviour.  Do NOT set panic_on_warn here; a WARN that reboots
#     the guest destroys the dmesg you needed.  Read it, then decide. ------
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_PANIC_TIMEOUT=0
