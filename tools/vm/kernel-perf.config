# AgentTx guest kernel: PERF build.
#
# EVERY NUMBER IN THE PAPER COMES FROM THIS KERNEL.
#
# P1-14, P2-11, P3-12 and P4-11 all produce measurements, and a measurement
# taken on the debug kernel measures KASAN's shadow-memory checks, not
# AgentTx.  The overhead figures would be wrong by more than the effect we
# are trying to report, which is the kind of mistake a reviewer finds and
# you do not.
#
# Everything here is an explicit =n of something kernel-debug.config turns
# on.  Stating them as =n rather than omitting them is deliberate: defconfig
# may enable some of these on its own, and silence is not the same as off.

CONFIG_KASAN=n
CONFIG_KASAN_VMALLOC=n
CONFIG_UBSAN=n

CONFIG_PROVE_LOCKING=n
CONFIG_LOCKDEP=n
CONFIG_DEBUG_LOCK_ALLOC=n
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_MUTEXES=n
CONFIG_DEBUG_RWSEMS=n
CONFIG_DEBUG_ATOMIC_SLEEP=n

CONFIG_DEBUG_OBJECTS=n
CONFIG_DEBUG_LIST=n
CONFIG_DEBUG_SG=n
CONFIG_DEBUG_KMEMLEAK=n
CONFIG_SLUB_DEBUG=n

# Kept on despite the cost: without frame pointers a `perf record` of the
# hook path gives you unusable stacks, and the hook path is the thing being
# measured.  The overhead is a small constant and it is present in the
# baseline run too, so it cancels.
CONFIG_FRAME_POINTER=y

# Kept on: an unattachable kernel that misbehaves mid-benchmark wastes more
# time than KASLR saves.
CONFIG_RANDOMIZE_BASE=n
CONFIG_GDB_SCRIPTS=y

# --- Measurement hygiene ---------------------------------------------------
# Deterministic timing needs the frequency governor and idle states pinned;
# run-vm.sh additionally passes `nohz_full` and `isolcpus` for the benchmark
# profile.  Document in the paper that measurements are taken inside a KVM
# guest -- it is a real caveat and stating it costs nothing.
CONFIG_NO_HZ_FULL=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
