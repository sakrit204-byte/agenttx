# AgentTx guest kernel: config fragment shared by both builds.
#
# Applied on top of `make defconfig kvm_guest.config` by build-kernel.sh via
# scripts/kconfig/merge_config.sh, so this file only states what AgentTx
# actually requires.  Nothing here is optional; build-kernel.sh re-checks
# every symbol after olddefconfig and refuses to build if one was dropped.
#
# A dropped symbol is the failure mode to fear.  merge_config.sh warns about
# conflicts on stderr and carries on, so a missing dependency turns a =y into
# a silent =n and you discover it three hours later when a BPF program will
# not attach.

# --- BPF and the LSM.  P3's entire stream. --------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_LSM=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y

# The LSM order string.  `bpf` MUST be present or bpf_lsm hooks never fire,
# and no error is reported anywhere -- your programs attach and silently do
# nothing.  run-vm.sh also passes lsm= on the cmdline; belt and braces,
# because a stale image and a fresh kernel disagreeing about this costs an
# afternoon.
CONFIG_SECURITY=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITYFS=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# --- Egress suppression.  P3-08 (deferral) depends on this. ---------------
#
# WHY THIS IS HERE, because it looks like an unrelated networking symbol:
#
# An LSM hook cannot express "report success but do not emit".
# security_socket_sendmsg() returns allow-or-deny and nothing else: return 0
# and the packet leaves, return an errno and userspace sees the failure.
# Deferral therefore needs a SECOND interception point, downstream of the
# syscall return -- the syscall reports success, and the emission is
# suppressed after it.  That point is a cgroup egress program.
#
# Without CONFIG_CGROUP_BPF the deferral half of the project cannot be built
# at all, and the failure is at attach time with an error that says the
# program type is unsupported rather than that a config symbol is missing.
CONFIG_CGROUP_BPF=y
CONFIG_CGROUPS=y
CONFIG_SOCK_CGROUP_DATA=y

# tc-based egress, kept as the fallback path if the cgroup route proves
# unworkable for a socket type we care about.
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y

# --- Tracing.  P4-02's collection, and uprobes for the TLS read path. -----
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE_SYSCALLS=y

# --- P2: copy-on-write storage. -------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_EXT4_FS=y
CONFIG_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y

# --- Per-transaction mount namespaces. ------------------------------------
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# --- Modules.  "insmod/rmmod x10 must not leak" is a review requirement,
#     so unload has to be possible in the first place. ----------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# --- gdb.  KASLR is off in BOTH configs: a benchmark kernel you cannot
#     attach to when it misbehaves is a false economy. ---------------------
CONFIG_GDB_SCRIPTS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_FRAME_POINTER=y
CONFIG_RANDOMIZE_BASE=n

# --- Guest plumbing: 9p for the shared repo, virtio for disk and net. -----
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
