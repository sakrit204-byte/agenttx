/* AgentTx desktop --- dark, agent-first. */
* { font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif; }
QWidget { background: #0b0f14; color: #e6edf3; font-size: 13px; }

#Header { background: #10161f; border-bottom: 1px solid #222c3a; }
#Brand  { font-size: 15px; font-weight: 700; letter-spacing: 1px; color: #e6edf3; }
#Tagline{ color: #6b7a8d; font-size: 11px; }

#TaskInput, #DirInput {
  background: #0e141c; border: 1px solid #253040; border-radius: 8px;
  padding: 10px 13px; font-size: 13px; color: #e6edf3;
  selection-background-color: #3a2a6e;
}
#TaskInput:focus, #DirInput:focus { border: 1px solid #a371f7; }

QPushButton {
  background: #161d27; border: 1px solid #253040; border-radius: 7px;
  padding: 8px 15px; color: #c3cedb; font-size: 12px;
}
QPushButton:hover  { border-color: #3a4757; color: #e6edf3; }
QPushButton:disabled { color: #4b5666; border-color: #1c2531; }
#Dispatch { background: #2a1d52; border: 1px solid #a371f7; color: #f0eaff;
            font-weight: 600; padding: 10px 22px; }
#Dispatch:hover { background: #38276e; }
#Commit { background: #0f2417; border: 1px solid #3fb950; color: #6ee787;
          font-weight: 600; padding: 11px 26px; font-size: 13px; }
#Commit:hover { background: #15361f; }
#Discard { background: #2a0f0e; border: 1px solid #f85149; color: #ff9d97;
           font-weight: 600; padding: 11px 26px; font-size: 13px; }
#Discard:hover { background: #3a1513; }
#Hood { background: #10161f; border: 1px solid #253040; color: #8b9aad; }
#Hood:checked { background: #2a1d52; border-color: #a371f7; color: #d8c7ff; }

#Side { background: #0d131a; border-right: 1px solid #222c3a; }
QListWidget { background: transparent; border: none; outline: none; }
QListWidget::item { border-radius: 8px; padding: 0px; margin: 3px 7px; }
QListWidget::item:selected { background: #17202c; }
QListWidget::item:hover { background: #131b25; }

#Card { background: #121820; border: 1px solid #222c3a; border-radius: 10px; }
#Headline { font-size: 21px; font-weight: 700; color: #e6edf3; }
#Sub { color: #8b9aad; font-size: 12.5px; }
#Muted { color: #6b7a8d; font-size: 11.5px; }
#Warn  { color: #d29922; font-size: 12.5px; }
#Danger{ color: #f85149; font-size: 12.5px; }
#Good  { color: #3fb950; font-size: 12.5px; }

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #263141; border-radius: 4px; min-height: 26px; }
QScrollBar::handle:vertical:hover { background: #33425a; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QPlainTextEdit, QTextEdit {
  background: #0a0e14; border: 1px solid #1c2531; border-radius: 8px;
  color: #9fb0c3; font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
  font-size: 11.5px; padding: 8px;
}
#Pill { border-radius: 9px; padding: 2px 9px; font-size: 10.5px; font-weight: 600; }
QSplitter::handle { background: #222c3a; }
QTabWidget::pane { border: 1px solid #222c3a; border-radius: 8px; top: -1px; }
QTabBar::tab { background: #10161f; color: #8b9aad; padding: 8px 16px;
               border: 1px solid #222c3a; border-bottom: none;
               border-top-left-radius: 7px; border-top-right-radius: 7px; margin-right: 3px; }
QTabBar::tab:selected { background: #161d27; color: #e6edf3; }

/* ---------------------------------------------------------- the chat
 *
 * A conversation, styled like one: the person's turns and the agent's
 * turns are visually different objects, and the tool calls between them
 * are quieter than both. The agent's reasoning is the thing being read;
 * the mechanics of each call are there when wanted and out of the way
 * when not.
 */
#ChatHead { background: #10161f; border-bottom: 1px solid #222c3a; }
#ChatScroll { background: #0b0f16; }

#YouMsg {
  background: #16202e; border: 1px solid #24344a;
  border-left: 3px solid #58a6ff; border-radius: 10px;
}
#AgentMsg {
  background: #121820; border: 1px solid #222c3a;
  border-left: 3px solid #a371f7; border-radius: 10px;
}
#ErrMsg {
  background: #1d1416; border: 1px solid #45252a;
  border-left: 3px solid #f85149; border-radius: 10px;
}
#Who { color: #6b7a8d; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; }

/* Tool calls: collapsed, low contrast, never competing with the prose. */
#Tool { background: #0e141c; border: 1px solid #1c2531; border-radius: 9px; }
#ToolName { color: #9fb0c3; font-size: 12px; }
#ToolBody { background: #070a0f; border: 1px solid #161d27; }
#Twisty {
  background: transparent; border: none; color: #6b7a8d;
  font-size: 12px; padding: 0;
}
#Twisty:hover { color: #e6edf3; }

#Divider { border-top: 1px solid #1c2531; }

#Review {
  background: #121820; border: 1px solid #2a3a22;
  border-left: 3px solid #3fb950; border-radius: 10px;
}

#DecideBar { background: #10161f; border-top: 1px solid #222c3a; }
#Composer  { background: #10161f; border-top: 1px solid #222c3a; }
#ChatInput {
  background: #0a0e14; border: 1px solid #222c3a; border-radius: 9px;
  color: #e6edf3; font-family: -apple-system, "Segoe UI", sans-serif;
  font-size: 13px; padding: 9px 11px;
}
#ChatInput:focus { border: 1px solid #58a6ff; }

/* Swarm: the plan, and the thing the plan can go wrong in. */
#Plan {
  background: #121820; border: 1px solid #243449;
  border-left: 3px solid #58a6ff; border-radius: 10px;
}
#Conflict {
  background: #1d1a14; border: 1px solid #4a3a1f;
  border-left: 3px solid #d29922; border-radius: 10px;
}
#LiveStrip { background: #0d131b; border-top: 1px solid #1c2531; }
#LiveVal { color: #9fb0c3; font-size: 11px;
           font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace; }

/* A notice is information, not a failure. */
#NoteMsg {
  background: #101821; border: 1px solid #1f2d3d;
  border-left: 3px solid #6b7a8d; border-radius: 10px;
}
#ConflictMsg {
  background: #1d1a14; border: 1px solid #4a3a1f;
  border-left: 3px solid #d29922; border-radius: 10px;
}

#NewChat {
  background: #1b2433; color: #e6edf3; border: 1px solid #2c3a4e;
  border-radius: 8px; padding: 7px 15px; font-size: 12.5px; font-weight: 600;
}
#NewChat:hover { background: #22304a; border: 1px solid #3a4d68; }
#Welcome { background: #0b0f16; }
#Mode {
  background: #10161f; color: #9fb0c3; border: 1px solid #222c3a;
  border-radius: 8px; padding: 6px 10px; font-size: 12px;
}
QPushButton:disabled { color: #4b5666; border-color: #1c2531; background: #0e141c; }

/* The layer picture. */
#LayerBox {
  background: #101a14; border: 1px solid #23402c;
  border-radius: 11px;
}
#RealBox {
  background: #141821; border: 1px solid #2a3344;
  border-radius: 11px;
}
#TxCard {
  background: #121820; border: 1px solid #2a3a52;
  border-left: 3px solid #58a6ff; border-radius: 10px;
}
#TxCard[hover="true"] {
  background: #17202e; border: 1px solid #58a6ff;
  border-left: 3px solid #58a6ff;
}
#Chip { border-radius: 6px; }
#DiffView {
  background: #0a0e14; border: 1px solid #1c2531; border-radius: 8px;
}
