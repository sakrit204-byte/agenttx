@inproceedings{porter2009txos,
  author    = {Porter, Donald E. and Hofmann, Owen S. and Rossbach,
               Christopher J. and Benn, Alexander and Witchel, Emmett},
  title     = {Operating System Transactions},
  booktitle = {Proceedings of the 22nd ACM Symposium on Operating Systems
               Principles (SOSP '09)},
  year      = {2009},
  address   = {Big Sky, MT, USA},
  publisher = {ACM},
  doi       = {10.1145/1629575.1629591},
  note      = {TxOS. VERIFIED against the paper 2026-08-04. 150 of 303 syscalls
               transactional (Table 1); socket/ipc/mq_open unsupported;
               unsupported call logs a warning or aborts per sys_xbegin flags
               (\S3.2); no irrevocable-transaction mechanism; application state
               not reverted on abort (\S3.1.4); request-response communication
               identified as non-transactional with buffering suggested and
               responsibility assigned to the programmer (\S3.1.5); long-running
               transaction sizing explicitly left as open policy (\S3.1.3)}
}

